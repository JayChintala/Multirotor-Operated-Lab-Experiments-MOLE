<?xml version="1.0"?>
<!-- Open field for the MOLE quad. Location: CMU campus, Pittsburgh (matches the SITL home in sitl.launch.py). -->
<sdf version="1.9">
  <world name="mole_field">
    <!-- ArduPilot SITL runs lock-step with Gazebo at 1 kHz -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.8 0.8 0.8</ambient>
      <background>0.75 0.82 0.9</background>
      <grid>false</grid>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.4433</latitude_deg>
      <longitude_deg>-79.9436</longitude_deg>
      <elevation>280</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.25 0.45 0.2 1</ambient><diffuse>0.25 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 5 m markers from the take-off point: north (+y, red) and east (+x, blue). Gazebo is ENU. -->
    <model name="axes">
      <static>true</static>
      <link name="link">
        <visual name="north"><pose>0 2.5 0.005 0 0 0</pose>
          <geometry><box><size>0.03 5 0.01</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
        <visual name="east"><pose>2.5 0 0.005 0 0 0</pose>
          <geometry><box><size>5 0.03 0.01</size></box></geometry>
          <material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://mole_quad</uri>
      <name>mole_quad</name>
      <pose degrees="true">0 0 0.0115 0 0 90</pose>
    </include>
  </world>
</sdf>

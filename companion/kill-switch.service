# Kill switch watchdog (kill_switch.py). Installed by setup.sh to
# /etc/systemd/system/kill-switch.service
[Unit]
Description=MOLE kill switch: force-disarm on laptop KILL or laptop link loss
After=mavlink-router.service
Wants=mavlink-router.service

[Service]
User=molepi
ExecStart=/home/molepi/mav/bin/python3 -u /home/molepi/mole/companion/kill_switch.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

<?xml version="1.0"?>
<robot name="emsd_qav_frame">
  <!--Motor locations are provisional arm-tip estimates in original CAD axes. Motor cylinders: placeholder diameter 28 mm, height 20 mm. No physical inertias assigned.-->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://emsd_drone_description/meshes/frame.stl" scale="1 1 1" />
      </geometry>
      <material name="carbon">
        <color rgba="0.18 0.18 0.20 1" />
      </material>
    </visual>
  </link>
  <link name="motor_1">
    <visual>
      <origin xyz="0 0 0.01" />
      <geometry>
        <cylinder radius="0.014" length="0.020" />
      </geometry>
      <material name="motor_color_1">
        <color rgba="0.15 0.35 0.75 1" />
      </material>
    </visual>
  </link>
  <joint name="motor_1_mount" type="fixed">
    <parent link="base_link" />
    <child link="motor_1" />
    <origin xyz="0.184 0.14 -0.0025" rpy="0 0 0" />
  </joint>
  <link name="motor_2">
    <visual>
      <origin xyz="0 0 0.01" />
      <geometry>
        <cylinder radius="0.014" length="0.020" />
      </geometry>
      <material name="motor_color_2">
        <color rgba="0.75 0.25 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="motor_2_mount" type="fixed">
    <parent link="base_link" />
    <child link="motor_2" />
    <origin xyz="-0.184 0.14 -0.0025" rpy="0 0 0" />
  </joint>
  <link name="motor_3">
    <visual>
      <origin xyz="0 0 0.01" />
      <geometry>
        <cylinder radius="0.014" length="0.020" />
      </geometry>
      <material name="motor_color_3">
        <color rgba="0.15 0.35 0.75 1" />
      </material>
    </visual>
  </link>
  <joint name="motor_3_mount" type="fixed">
    <parent link="base_link" />
    <child link="motor_3" />
    <origin xyz="-0.184 -0.14 -0.0025" rpy="0 0 0" />
  </joint>
  <link name="motor_4">
    <visual>
      <origin xyz="0 0 0.01" />
      <geometry>
        <cylinder radius="0.014" length="0.020" />
      </geometry>
      <material name="motor_color_4">
        <color rgba="0.75 0.25 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="motor_4_mount" type="fixed">
    <parent link="base_link" />
    <child link="motor_4" />
    <origin xyz="0.184 -0.14 -0.0025" rpy="0 0 0" />
  </joint>
</robot>

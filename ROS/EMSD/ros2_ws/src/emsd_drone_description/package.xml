<?xml version="1.0"?>
<package format="3">
  <name>emsd_drone_description</name><version>0.1.0</version>
  <description>QAV-RXL2 description and force-driven flight simulation for EMSD.</description>
  <maintainer email="maintainer@example.com">EMSD</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Gazebo Harmonic on Jazzy (and later); Gazebo Fortress on Humble. -->
  <build_depend condition="$ROS_DISTRO != humble">gz_sim_vendor</build_depend>
  <build_depend condition="$ROS_DISTRO != humble">gz_physics_vendor</build_depend>
  <build_depend condition="$ROS_DISTRO != humble">gz_plugin_vendor</build_depend>
  <build_depend condition="$ROS_DISTRO == humble">ignition-gazebo6</build_depend>
  <build_depend condition="$ROS_DISTRO == humble">ignition-physics5</build_depend>
  <build_depend condition="$ROS_DISTRO == humble">ignition-plugin1</build_depend>
  <build_depend>python3-dev</build_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>

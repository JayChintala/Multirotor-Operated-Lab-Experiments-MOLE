<?xml version="1.0"?>
<package format="3">
  <name>mole_mocap</name>
  <version>0.1.0</version>
  <description>Vicon motion capture for the MOLE quad: Vicon pose to ArduPilot via MAVROS (real drone), and a simulated Vicon from Gazebo ground truth (SITL).</description>
  <maintainer email="noreply@github.com">MOLE team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- vicon_receiver (github.com/OPT4SMART/ros2-vicon-receiver) is built from source in the
       same workspace; only vicon.launch.py needs it, so it is not a hard dependency. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
